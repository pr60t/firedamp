# Firedamp Live Scan Credentials
# Copy this file to .env (which is gitignored) or export these variables
# in your shell before running non-dry-run scans against a target instance.

# Mode A: Existing Identities (Default: --identity-mode existing)
# Pre-existing test persona accounts on target platform.
# Firedamp will NEVER delete these accounts during scan cleanup.
FIREDAMP_ALICE_USERNAME=alice_owner
FIREDAMP_ALICE_PASSWORD=replace-with-alice-test-password

FIREDAMP_BOB_USERNAME=bob_attacker
FIREDAMP_BOB_PASSWORD=replace-with-bob-test-password

# Mode B: Optional Dynamic Provisioning (--identity-mode provision --confirm-provisioning)
# Administrative credential required ONLY when Firedamp dynamically provisions
# run-scoped test accounts (Alice/Bob) and deletes them after verification.
# FIREDAMP_PROVISION_ADMIN_TOKEN=your-target-platform-admin-jwt-token
